{
  "schemaVersion": 1,
  "policyId": "EP-COM-003",
  "canonicalProductName": "EnvPlane",
  "licensePolicy": "No license or repository visibility change without legal checkpoint approval.",
  "publicRepositories": [
    {"name": "contracts", "responsibility": "versioned public contracts, OpenAPI and SDK"},
    {"name": "agent", "responsibility": "cluster discovery and observed inventory"},
    {"name": "runner", "responsibility": "constrained runtime transport and execution"},
    {"name": "webhook", "responsibility": "SCM webhook validation and normalization"},
    {"name": "bootstrap", "responsibility": "project onboarding and discovery"},
    {"name": "gitops", "responsibility": "rendering and repository-writing integrations"},
    {"name": "control-plane", "responsibility": "community lifecycle and orchestration core"},
    {"name": "frontend", "responsibility": "community web UI"},
    {"name": "deploy", "responsibility": "charts, installation and signed release metadata"}
  ],
  "privateModuleBoundaries": [
    {"id": "managed-operations", "dependsOn": ["contracts", "extension-interfaces"]},
    {"id": "commercial-policy-and-entitlements", "dependsOn": ["contracts", "extension-interfaces"]},
    {"id": "fleet-operations", "dependsOn": ["contracts", "extension-interfaces"]},
    {"id": "private-deployment-and-airgap", "dependsOn": ["contracts", "extension-interfaces"]}
  ],
  "dependencyRules": {
    "privateMayDependOnPublic": true,
    "publicMayDependOnPrivate": false,
    "publicMayFetchPrivateDynamically": false,
    "privateForkOfPublicCoreAllowed": false,
    "enterpriseFailureMayBlockCommunityFlow": false,
    "plaintextCredentialsAcrossBoundary": false,
    "crossTenantDataAcrossBoundary": false
  },
  "extensionInterfaces": [
    "identity",
    "entitlements",
    "policy-evaluation",
    "audit-sink",
    "finops",
    "managed-operations"
  ],
  "releaseArtifactComposition": {
    "publicCompatibilitySetFirst": true,
    "enterpriseAdditionsSeparatelyVersioned": true,
    "publicMetadataMayContainPrivateSource": false,
    "credentialsInline": false,
    "compatibilityDeclarationRequired": true
  },
  "legalCheckpoint": [
    "apache-2.0-notices-and-third-party-provenance",
    "cla-and-contributor-provenance",
    "envplane-trademark-policy",
    "independent-enterprise-authorship",
    "public-private-support-and-upgrade-boundaries",
    "release-artifact-and-customer-license-review"
  ]
}
